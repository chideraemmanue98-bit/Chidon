# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# OPENAI_API_KEY: Optional server-side fallback AI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# FIREBASE CLIENT CONFIGURATION (public browser configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# SUPABASE INTEGRATION Configuration:
# Enable automatic, out-of-the-box secure client connections to your database
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NATIVE GOOGLE CLOUD SQL / POSTGRES AT RUNTIME (Server-Side direct connector)
SQL_HOST=
SQL_DB_NAME=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=

# PAYSTACK SECURE PAYMENT CONFIGURATION
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
USD_TO_NGN_RATE=1500
