# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HUGGINGFACE_API_KEY: Optional secondary AI engine.
HUGGINGFACE_API_KEY="MY_HUGGINGFACE_API_KEY"

# PAYSTACK_SECRET_KEY: Required for secure Paystack transaction initialization and verification
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"

# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY: Reusable Paystack client public key for USD checkout
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"

