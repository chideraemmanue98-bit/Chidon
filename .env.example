# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# HUGGINGFACE_API_KEY: Optional secondary AI engine.
HUGGINGFACE_API_KEY=

# SUPABASE INTEGRATION Configuration:
# Enable automatic, out-of-the-box secure client connections to your database
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NATIVE GOOGLE CLOUD SQL / POSTGRES AT RUNTIME (Server-Side direct connector)
SQL_HOST=
SQL_DB_NAME=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=

# PAYSTACK SECURE PAYMENT CONFIGURATION
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
USD_TO_NGN_RATE=1500
