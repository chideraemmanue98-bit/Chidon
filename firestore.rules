rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Feedback Validation
    function isValidFeedback(data) {
      return data.keys().hasAll(['featureId', 'rating', 'timestamp', 'generatedContent']) &&
             data.keys().size() <= 7 &&
             data.featureId is string && data.featureId.size() <= 50 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.timestamp == request.time &&
             data.generatedContent is string && data.generatedContent.size() <= 20000 &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // ScheduledPost Validation
    function isValidScheduledPost(data) {
      return data.keys().hasAll(['caption', 'scheduledAt', 'platform', 'status', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.caption is string && data.caption.size() <= 5000 &&
             data.scheduledAt is timestamp &&
             data.platform is string && data.platform.size() <= 50 &&
             data.status in ['scheduled', 'published', 'failed'] &&
             data.createdAt == request.time &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2000)) &&
             (!('userId' in data) || (isSignedIn() && data.userId == request.auth.uid));
    }

    // Draft Validation
    function isValidDraft(data) {
      return data.keys().hasAll(['featureId', 'content', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.featureId is string && data.featureId.size() <= 50 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt == request.time &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('userId' in data) || (isSignedIn() && data.userId == request.auth.uid));
    }

    // Note Validation
    function isValidNote(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 7 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 50000 &&
             data.updatedAt == request.time &&
             (data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('tags' in data) || (data.tags is list)) &&
             (!('folderId' in data) || (data.folderId is string)) &&
             (!('userId' in data) || (isSignedIn() && data.userId == request.auth.uid));
    }

    // Folder Validation
    function isValidFolder(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.keys().size() <= 3 &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt == request.time &&
             (!('userId' in data) || (isSignedIn() && data.userId == request.auth.uid));
    }

    // Presence Validation
    function isValidPresence(data) {
      return data.keys().hasAll(['userName', 'userColor', 'cursorIndex', 'lastActive']) &&
             data.keys().size() <= 4 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.userColor is string && data.userColor.size() <= 50 &&
             data.cursorIndex is number &&
             data.lastActive == request.time;
    }

    // ChimePost Validation
    function isValidChimePost(data) {
      return data.keys().hasAll(['content', 'authorId', 'authorName', 'createdAt']) &&
             data.keys().size() <= 5 &&
             data.content is string && data.content.size() <= 10000 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.createdAt == request.time &&
             (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 2000));
    }

    // GlobalPresence Validation
    function isValidGlobalPresence(data) {
      return data.keys().hasAll(['userName', 'lastActive', 'userColor', 'cursorIndex']) &&
             data.keys().size() <= 5 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.lastActive == request.time &&
             data.userColor is string && data.userColor.size() <= 50 &&
             data.cursorIndex is number &&
             (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 2000));
    }

    // User Validation for GigSocial & Chidon IQ
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().size() <= 30 &&
             data.email is string && data.email.size() <= 150 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 150)) &&
             (!('avatarURL' in data) || (data.avatarURL is string && data.avatarURL.size() <= 2000)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
             (!('skills' in data) || (data.skills is list)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
             (!('rating' in data) || (data.rating is number)) &&
             (!('creatorRole' in data) || (data.creatorRole is string && data.creatorRole.size() <= 100)) &&
             (!('experienceLevel' in data) || (data.experienceLevel is string && data.experienceLevel.size() <= 50)) &&
             (!('systemLanguage' in data) || (data.systemLanguage is string && data.systemLanguage.size() <= 50)) &&
             (!('generationTone' in data) || (data.generationTone is string && data.generationTone.size() <= 50)) &&
             (!('apiKeys' in data) || (data.apiKeys is map)) &&
             (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan.size() <= 100)) &&
             (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus.size() <= 50)) &&
             (!('subscriptionPrice' in data) || (data.subscriptionPrice is number)) &&
             (!('paystackSubscriptionRef' in data) || (data.paystackSubscriptionRef is string && data.paystackSubscriptionRef.size() <= 100)) &&
             (!('credits' in data) || (data.credits is number)) &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // Portfolio Validation
    function isValidPortfolio(data) {
      return data.keys().hasAll(['userId', 'title', 'description', 'images', 'category', 'price', 'deliveryDays']) &&
             data.keys().size() <= 8 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 3000 &&
             data.images is list &&
             data.category is string &&
             data.price is number && data.price >= 0 &&
             data.deliveryDays is number && data.deliveryDays >= 0;
    }

    // Gig Validation
    function isValidGig(data) {
      return data.keys().hasAll(['userId', 'title', 'description', 'category', 'tags', 'priceFrom', 'portfolioId', 'createdAt']) &&
             data.keys().size() <= 9 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 3000 &&
             data.category is string &&
             data.tags is list &&
             data.priceFrom is number && data.priceFrom >= 0 &&
             data.portfolioId is string &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // Message Validation
    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'content', 'read', 'type', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.receiverId is string && data.receiverId.size() <= 128 &&
             data.content is string && data.content.size() <= 5000 &&
             data.read is bool &&
             data.type is string &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // Order Validation
    function isValidOrder(data) {
      return data.keys().hasAll(['buyerId', 'sellerId', 'gigId', 'status', 'amount', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.gigId is string && data.gigId.size() <= 128 &&
             data.status is string &&
             data.amount is number && data.amount >= 0 &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // Follow Validation
    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt']) &&
             data.keys().size() <= 4 &&
             data.followerId is string && data.followerId.size() <= 128 &&
             data.followingId is string && data.followingId.size() <= 128 &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // Job Validation
    function isValidJob(data) {
      return data.keys().hasAll(['title', 'department', 'location', 'type', 'salary', 'description', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.title is string && data.title.size() <= 100 &&
             data.department is string && data.department.size() <= 100 &&
             data.location is string && data.location.size() <= 100 &&
             data.type is string && data.type.size() <= 50 &&
             data.salary is string && data.salary.size() <= 100 &&
             data.description is string && data.description.size() <= 5000 &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // JobApplication Validation
    function isValidJobApplication(data) {
      return data.keys().hasAll(['jobId', 'jobTitle', 'candidateName', 'email', 'resumeUrl', 'motivation', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.jobId is string && data.jobId.size() <= 128 &&
             data.jobTitle is string && data.jobTitle.size() <= 100 &&
             data.candidateName is string && data.candidateName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.resumeUrl is string && data.resumeUrl.size() <= 2000 &&
             data.motivation is string && data.motivation.size() <= 5000 &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // Rules Definitions
    match /notifications/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users/{userId} {
      allow read, write: if true;

      match /receipts/{receiptId} {
        allow read, write: if true;
      }

      match /transactions/{transactionId} {
        allow read, write: if true;
      }

      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    match /scheduled_posts/{postId} {
      allow read, write: if true;
    }

    match /drafts/{draftId} {
      allow read, write: if true;
    }

    match /notes/{noteId} {
      allow read, write: if true;
    }

    match /folders/{folderId} {
      allow read, write: if true;
    }

    match /presence/{noteId}/users/{userId} {
      allow read, write: if true;
    }

    match /chime_posts/{postId} {
      allow read, write: if true;
    }

    match /jobs/{jobId} {
      allow read, write: if true;
    }

    match /job_applications/{appId} {
      allow read, write: if true;
    }

    match /earn_jobs/{jobId} {
      allow read, write: if true;
    }

    match /earn_services/{svcId} {
      allow read, write: if true;
    }

    match /earn_results/{resId} {
      allow read, write: if true;
    }

    match /earn_profiles/{profileId} {
      allow read, write: if true;
    }

    match /profiles/{profileId} {
      allow read, write: if true;
    }

    match /global_presence/{userId} {
      allow read, write: if true;
    }

    // GigSocial Security Rules
    match /portfolios/{portfolioId} {
      allow read, write: if true;
    }

    match /gigs/{gigId} {
      allow read, write: if true;
    }

    match /messages/{chatId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /follows/{followId} {
      allow read, write: if true;
    }

    // Chidon Marketplace & Chat Rules
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (request.auth.uid == chatId || (resource != null && resource.data != null && resource.data.participants != null && request.auth.uid in resource.data.participants));

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }

      // Tool chat history support
      match /features/{featureId}/messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == chatId;
      }
    }

    match /blogs/{blogId} {
      allow read, write: if true;
      
      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}
