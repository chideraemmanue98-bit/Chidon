{
  "entities": {
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback for generated features",
      "type": "object",
      "properties": {
        "featureId": {
          "type": "string",
          "description": "The ID of the feature (e.g., content-ideas, hashtags)"
        },
        "rating": {
          "type": "number",
          "description": "Rating from 1 to 5"
        },
        "comment": {
          "type": "string",
          "description": "User's text feedback"
        },
        "generatedContent": {
          "type": "string",
          "description": "The actual content that was generated"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the feedback was submitted"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user who submitted feedback (optional if anonymous)"
        }
      },
      "required": ["featureId", "rating", "timestamp"]
    },
    "ScheduledPost": {
      "title": "Scheduled Post",
      "description": "A scheduled social media post",
      "type": "object",
      "properties": {
        "caption": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "mediaUrl": { "type": "string" },
        "platform": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "published", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["caption", "scheduledAt", "platform", "status", "createdAt"]
    },
    "Draft": {
      "title": "Draft",
      "description": "Saved generated content",
      "type": "object",
      "properties": {
        "featureId": { "type": "string" },
        "content": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["featureId", "content", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "User created or edited notes",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "folderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "content", "createdAt", "updatedAt"]
    },
    "Folder": {
      "title": "Folder",
      "description": "Organizational container for notes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Real-time user presence and cursor data",
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "userColor": { "type": "string" },
        "cursorIndex": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["userName", "userColor", "cursorIndex", "lastActive"]
    },
    "ChimePost": {
      "title": "Chime Post",
      "description": "Feed posts in the community chime hub",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "authorId", "authorName", "createdAt"]
    },
    "GlobalPresence": {
      "title": "Global Presence",
      "description": "Global user presence and status tracking",
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" },
        "userColor": { "type": "string" },
        "cursorIndex": { "type": "number" }
      },
      "required": ["userName", "lastActive", "userColor", "cursorIndex"]
    },
    "User": {
      "title": "User",
      "description": "User profile with synchronized settings and credentials in GigSocial/Chidon IQ",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "username": { "type": "string" },
        "fullName": { "type": "string" },
        "avatarURL": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "country": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Portfolio": {
      "title": "Portfolio",
      "description": "Showcase of creator works and deliverables",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "deliveryDays": { "type": "number" }
      },
      "required": ["userId", "title", "description", "category", "price", "deliveryDays"]
    },
    "Gig": {
      "title": "Gig",
      "description": "Active freelance job listing broadcasted by a creator",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "priceFrom": { "type": "number" },
        "portfolioId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "description", "category", "priceFrom", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time communication message inside a specific secure channel",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "content", "read", "type", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Freelance escrows and transactions tracking",
      "type": "object",
      "properties": {
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "gigId": { "type": "string" },
        "status": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerId", "sellerId", "gigId", "status", "amount", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Subscribers/follows relationship between creator nodes",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    }
  },
  "firestore": {
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Collection of user feedback entries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Secure user details and settings synced across sessions"
    },
    "/scheduled_posts/{postId}": {
      "schema": "ScheduledPost",
      "description": "Collection of social media posts scheduled by users"
    },
    "/drafts/{draftId}": {
      "schema": "Draft",
      "description": "Collection of saved content drafts"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Collection of personal notes"
    },
    "/folders/{folderId}": {
      "schema": "Folder",
      "description": "Collection of organizational folders"
    },
    "/presence/{noteId}/users/{userId}": {
      "schema": "Presence",
      "description": "Collection for tracking active users in a specific note"
    },
    "/chime_posts/{postId}": {
      "schema": "ChimePost",
      "description": "Collection of community chime hub posts"
    },
    "/global_presence/{userId}": {
      "schema": "GlobalPresence",
      "description": "Collection of global active users"
    },
    "/portfolios/{portfolioId}": {
      "schema": "Portfolio",
      "description": "Collection of creator portfolio showcases"
    },
    "/gigs/{gigId}": {
      "schema": "Gig",
      "description": "Collection of freelance gig cards"
    },
    "/messages/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Sub-collection of active live chat texts"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of escrow payments"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Collection of follower actions"
    }
  }
}
